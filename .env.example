# Copy this file to .env and add a key to get AI-written drafts.
# Without a key the app still works and writes drafts from a template.
ANTHROPIC_API_KEY=
# PORT=4410

# Optional: connect Gmail to save drafts into your inbox and detect replies.
# Create an OAuth client (type: Web application) in Google Cloud with the Gmail API enabled
# and this redirect URI: http://localhost:4410/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
